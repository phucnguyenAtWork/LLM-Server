# Database — copy this to .env and fill in your values
DB_HOST=<your-db-host>
DB_PORT=3308
DB_USER=root
DB_PASSWORD=<your-db-password>
DB_NAME=financedb

# AWAD2 finance service base URL. FINA calls /api/fina/* through this base.
MAC_API_URL=http://localhost:4001/api

# FINA API host/port exposed to AWAD2 through FINA_API_URL.
FINA_HOST=0.0.0.0
FINA_PORT=8105

# Number of retrieved financial evidence rows appended to chat context.
RAG_TOP_K=6
